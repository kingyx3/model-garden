{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://modelgarden.ai/schemas/v1/model-profile.schema.json",
  "title": "Model Garden ModelProfile v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": {"const": "modelgarden.ai/v1"},
    "kind": {"const": "ModelProfile"},
    "metadata": {"type": "object", "additionalProperties": false, "required": ["name", "owner"], "properties": {"name": {"type": "string", "minLength": 1}, "owner": {"type": "string", "minLength": 1}, "description": {"type": "string"}}},
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidates"],
      "properties": {
        "candidates": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "object", "additionalProperties": false, "required": ["provider", "model"], "properties": {"provider": {"type": "string"}, "model": {"type": "string"}, "priority": {"type": "integer", "minimum": 1}}}
        },
        "constraints": {"type": "object", "additionalProperties": false, "properties": {"maxDataClassification": {"enum": ["public", "internal", "confidential", "restricted"]}, "regions": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}}},
        "routing": {"type": "object", "additionalProperties": false, "properties": {"strategy": {"enum": ["quality-first", "cost-first", "latency-first", "ordered-fallback"]}}}
      }
    }
  }
}
