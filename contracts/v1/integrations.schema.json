{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://modelgarden.ai/schemas/v1/integrations.schema.json",
  "title": "Model Garden Integration Registry v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "kind",
    "registryVersion",
    "providers"
  ],
  "properties": {
    "apiVersion": {
      "const": "modelgarden.ai/v1"
    },
    "kind": {
      "const": "IntegrationRegistry"
    },
    "registryVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "providers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "family",
          "method",
          "tier",
          "status",
          "tools",
          "issue"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "family": {
            "type": "string",
            "pattern": "^[a-z]+$"
          },
          "method": {
            "enum": [
              "native",
              "governed-mcp",
              "long-tail",
              "built-in",
              "file"
            ]
          },
          "tier": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4
          },
          "status": {
            "enum": [
              "live",
              "built-credential-free",
              "in-development",
              "planned"
            ]
          },
          "tools": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "issue": {
            "type": "integer",
            "minimum": 1
          },
          "adapter": {
            "type": "string",
            "pattern": "^platform/[a-z_/-]+\\.py$"
          },
          "proof": {
            "type": "string",
            "minLength": 1
          },
          "scopeByTool": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    }
  }
}
