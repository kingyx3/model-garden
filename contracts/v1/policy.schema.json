{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://modelgarden.ai/schemas/v1/policy.schema.json",
  "title": "Model Garden Policy v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": {"const": "modelgarden.ai/v1"},
    "kind": {"const": "Policy"},
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "owner"],
      "properties": {
        "name": {"type": "string"},
        "owner": {"type": "string"},
        "description": {"type": "string"}
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rules"],
      "properties": {
        "rules": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "effect"],
            "properties": {
              "id": {"type": "string", "minLength": 1, "maxLength": 64},
              "effect": {"enum": ["allow", "deny", "require-approval", "human-only"]},
              "description": {"type": "string"},
              "assignee": {"type": "string", "minLength": 1, "maxLength": 256, "description": "Required for human-only: the named person (or role mailbox) who performs the action."},
              "deadlineHours": {"type": "integer", "minimum": 1, "maximum": 720, "description": "For human-only: hours the assignee has before the hand-off is reported as overdue (default 24)."},
              "actions": {
                "type": "array",
                "items": {"type": "string", "minLength": 1},
                "description": "Tool names or glob patterns such as calendar.book, mail.send or crm.*. An allow rule must list its actions."
              },
              "dataClassifications": {
                "type": "array",
                "items": {"enum": ["public", "internal", "confidential", "restricted"]}
              },
              "channels": {
                "type": "array",
                "items": {"type": "string", "minLength": 1, "maxLength": 256},
                "description": "Narrow the rule to these channels (for example voice, slack, email)."
              },
              "principals": {
                "type": "array",
                "items": {"enum": ["member", "public"]},
                "uniqueItems": true,
                "description": "Principal types the rule covers. Omitted: deny and require-approval cover everyone; allow covers members only. Naming public is the only way to let a public principal use a write Tool."
              },
              "signoff": {
                "type": "object",
                "additionalProperties": false,
                "required": ["owner", "ruleDigest"],
                "properties": {
                  "owner": {"type": "string", "minLength": 1},
                  "ruleDigest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
                },
                "description": "Named client owner's sign-off for an allow rule that relaxes an approval requirement. ruleDigest binds the sign-off to the rule's exact content (every field except signoff), so any later edit blocks compilation until the owner re-signs."
              }
            }
          }
        }
      }
    }
  }
}
