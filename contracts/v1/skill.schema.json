{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://modelgarden.ai/schemas/v1/skill.schema.json",
  "title": "Model Garden Skill v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": {"const": "modelgarden.ai/v1"},
    "kind": {"const": "Skill"},
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "owner"],
      "properties": {
        "name": {"type": "string", "pattern": "^[a-z0-9]([a-z0-9.-]*[a-z0-9])?$"},
        "owner": {"type": "string", "minLength": 1},
        "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "description": {"type": "string"}
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["instructions"],
      "properties": {
        "instructions": {"type": "object", "additionalProperties": false, "required": ["file"], "properties": {"file": {"type": "string"}}},
        "allowedTools": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "inputs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "outputSchema": {"type": "string"},
        "evaluationSuite": {"type": "string"}
      }
    }
  }
}
