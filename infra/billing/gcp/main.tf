# The shared Model Garden billing host: self-hosted Lago plus the billing sync, on one private VM.
#
# One instance for all clients. Lago (API, worker, clock, front, PDF, Postgres, Redis) runs under Docker Compose with its state on a
# separate persistent disk that is snapshotted daily, and Postgres is dumped nightly to a bucket. The host has no public address:
# operators reach the Lago UI and API through IAP tunnels. Its service account is the billing identity: each client environment names
# it as a ledger export verifier, so the billing sync can read the exported usage and nothing else. Every secret is generated by
# Terraform as an ephemeral value and written to Secret Manager write-only, so none of them is ever stored in Terraform state.

terraform {
  required_version = ">= 1.11.0"

  backend "gcs" {}

  required_providers {
    google = {
      source  = "hashicorp/google"
      version = "~> 8.2"
    }
    random = {
      source  = "hashicorp/random"
      version = "~> 3.7"
    }
    tls = {
      source  = "hashicorp/tls"
      version = "~> 4.1"
    }
  }
}

provider "google" {
  project = var.project_id
  region  = var.region
  zone    = var.zone
}

locals {
  name = "mg-billing-${var.environment}"
  labels = {
    project          = "model-garden"
    component        = "billing"
    platform_version = replace(var.platform_version, ".", "-")
    environment      = var.environment
    managed_by       = "terraform"
  }
  repository = "${path.module}/../../.."
  # The billing sync and the modules it loads, shipped to the host through instance metadata (base64, so nothing is re-templated).
  billing_files = {
    "scripts/billing-sync.py"        = filebase64("${local.repository}/scripts/billing-sync.py")
    "platform/metering/billing.py"   = filebase64("${local.repository}/platform/metering/billing.py")
    "platform/metering/lago.py"      = filebase64("${local.repository}/platform/metering/lago.py")
    "platform/core/ledger_export.py" = filebase64("${local.repository}/platform/core/ledger_export.py")
  }
  billing_config = {
    lago     = { url = "http://127.0.0.1:3000" }
    stateDir = "/var/lib/lago/billing"
    sources = [for source in var.billing_sources : {
      client       = source.client
      environment  = source.environment
      subscription = source.subscription
      bucket       = source.bucket
      prefix       = source.prefix
      agents       = source.agents
    }]
  }
  compose = templatefile("${path.module}/templates/compose.yaml.tftpl", {
    lago_version = var.lago_version
    api_url      = var.lago_api_url
    front_url    = var.lago_front_url
    organization = var.lago_organization
    admin_email  = var.lago_admin_email
  })
  startup_script = templatefile("${path.module}/templates/startup.sh.tftpl", {
    compose        = local.compose
    billing_files  = local.billing_files
    billing_config = yamlencode(local.billing_config)
    sync_minutes   = var.billing_sync_minutes
    backup_bucket  = google_storage_bucket.backups.name
    data_disk      = local.data_disk_device
    secrets        = { for key, secret in google_secret_manager_secret.lago : key => secret.secret_id }
  })
  data_disk_device = "lago-data"
}

resource "google_project_service" "billing" {
  for_each = toset(["compute.googleapis.com", "iap.googleapis.com", "secretmanager.googleapis.com", "storage.googleapis.com"])

  service            = each.value
  disable_on_destroy = false
}

# With `host_image` empty the boot image is the newest debian-12 image when Terraform runs; name an image to pin the rebuild input.
data "google_compute_image" "debian" {
  family  = var.host_image == "" ? "debian-12" : null
  name    = var.host_image == "" ? null : var.host_image
  project = "debian-cloud"
}

resource "google_compute_network" "billing" {
  name                    = local.name
  auto_create_subnetworks = false

  depends_on = [google_project_service.billing]
}

resource "google_compute_subnetwork" "billing" {
  name                     = local.name
  region                   = var.region
  network                  = google_compute_network.billing.id
  ip_cidr_range            = var.subnet_cidr
  private_ip_google_access = true

  log_config {
    aggregation_interval = "INTERVAL_5_SEC"
    flow_sampling        = 0.5
    metadata             = "INCLUDE_ALL_METADATA"
  }
}

resource "google_compute_router" "billing" {
  name    = "${local.name}-nat"
  region  = var.region
  network = google_compute_network.billing.id
}

# Outbound only, for package and image pulls; nothing can reach the host except through IAP.
resource "google_compute_router_nat" "billing" {
  name                               = "${local.name}-nat"
  router                             = google_compute_router.billing.name
  region                             = var.region
  nat_ip_allocate_option             = "AUTO_ONLY"
  source_subnetwork_ip_ranges_to_nat = "ALL_SUBNETWORKS_ALL_IP_RANGES"

  log_config {
    enable = true
    filter = "ERRORS_ONLY"
  }
}

# SSH, the Lago front end (80) and the Lago API (3000), from Google's IAP forwarding range only.
resource "google_compute_firewall" "iap" {
  name    = "${local.name}-iap"
  network = google_compute_network.billing.name

  direction     = "INGRESS"
  source_ranges = ["35.235.240.0/20"]
  target_tags   = ["model-garden-billing"]

  allow {
    protocol = "tcp"
    ports    = ["22", "80", "3000"]
  }
}

resource "google_service_account" "billing" {
  account_id   = local.name
  display_name = "Model Garden billing (${var.environment})"
}

resource "google_project_iam_member" "billing_logs" {
  for_each = toset(["roles/logging.logWriter", "roles/monitoring.metricWriter"])

  project = var.project_id
  role    = each.value
  member  = "serviceAccount:${google_service_account.billing.email}"
}

resource "google_compute_disk" "data" {
  #checkov:skip=CKV_GCP_37:Google-managed encryption is the managed baseline; customer-managed keys are added when a requirement justifies separate key control.
  name   = "${local.name}-data"
  type   = "pd-balanced"
  zone   = var.zone
  size   = var.data_disk_gb
  labels = local.labels

  lifecycle {
    prevent_destroy = true
  }
}

resource "google_compute_resource_policy" "snapshots" {
  name   = "${local.name}-daily"
  region = var.region

  snapshot_schedule_policy {
    schedule {
      daily_schedule {
        days_in_cycle = 1
        start_time    = "03:00"
      }
    }
    retention_policy {
      max_retention_days    = var.snapshot_retention_days
      on_source_disk_delete = "KEEP_AUTO_SNAPSHOTS"
    }
    snapshot_properties {
      labels = local.labels
    }
  }
}

resource "google_compute_disk_resource_policy_attachment" "snapshots" {
  name = google_compute_resource_policy.snapshots.name
  disk = google_compute_disk.data.name
  zone = var.zone
}

resource "google_compute_instance" "billing" {
  #checkov:skip=CKV_GCP_38:Google-managed disk encryption is the managed baseline; customer-managed keys are added when a requirement justifies separate key control.
  name         = local.name
  machine_type = var.machine_type
  zone         = var.zone
  labels       = local.labels
  tags         = ["model-garden-billing"]

  allow_stopping_for_update = true

  boot_disk {
    initialize_params {
      image = data.google_compute_image.debian.self_link
      size  = 30
      type  = "pd-balanced"
    }
  }

  attached_disk {
    source      = google_compute_disk.data.id
    device_name = local.data_disk_device
  }

  network_interface {
    subnetwork = google_compute_subnetwork.billing.id
  }

  # The startup script runs on every boot and is idempotent: changing it (a new Lago version, a new client source, a new
  # billing sync) takes effect on the next reboot, or at once with `sudo google_metadata_script_runner startup`.
  metadata = {
    enable-oslogin         = "TRUE"
    block-project-ssh-keys = "TRUE"
    startup-script         = local.startup_script
  }

  service_account {
    email  = google_service_account.billing.email
    scopes = ["https://www.googleapis.com/auth/cloud-platform"]
  }

  shielded_instance_config {
    enable_secure_boot          = true
    enable_vtpm                 = true
    enable_integrity_monitoring = true
  }

  lifecycle {
    precondition {
      condition     = var.environment != "prod" || var.deletion_protection
      error_message = "The production billing host must enable deletion_protection."
    }
  }

  deletion_protection = var.deletion_protection

  depends_on = [google_compute_router_nat.billing, google_secret_manager_secret_version.lago]
}
